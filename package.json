{
  "name": "dsh-mermaid-renderer",
  "version": "0.1.0",
  "description": "Render ```mermaid fenced diagrams inline in DeepSeek Harness chat with pan/zoom and fullscreen — always pure vector SVG",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "mermaid",
    "diagram",
    "chat"
  ],
  "license": "MIT",
  "files": [
    "lib",
    "cordis.patch.yml"
  ]
}